# Copy to .env.local for local overrides. .env and .env.local are gitignored.
#
# There is no seed or private key here, on purpose. Every transaction is signed
# by the Lace extension through the DApp connector.

# MidBid registry on Preprod. The Browse page lists auctions from it.
# Deploy one from #/setup, then paste its address here.
# Pilot register: the opt-in public list of Preprod testers.
VITE_PILOT_ADDRESS=

VITE_REGISTRY_ADDRESS=ae709b8abed530b6256727c8a4a68b99fc7294d24eead048536d8c93617f39ec

# Product profile on X, linked from the footer. Hidden when empty.
VITE_X_PROFILE_URL=https://x.com/midnight_bid

# Network endpoints. The defaults are Midnight's public Preprod services.
VITE_NETWORK_ID=preprod
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
VITE_NODE_URL=https://rpc.preprod.midnight.network

# Local proof server, started with: npm run proof-server
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Optional hosted proof server. Blank means proving is local only, which is the
# private option. Setting it lets testers opt in to hosted proving, which
# discloses their bid amount and bidder secret to whoever runs it.
# Read docs/PROVING.md before setting this.
VITE_HOSTED_PROOF_SERVER_URL=
